{
  "schemaVersion": 2,
  "name": "JARVIS",
  "mode": "local-first",
  "studioOS": {
    "configFile": "local/config.json",
    "access": "manual"
  },
  "execution": {
    "automaticExternalCalls": false,
    "paidServicesRequired": false
  },
  "projectMemory": {
    "file": "local/project-state.json",
    "template": "templates/project-state.json",
    "updateAfterMeaningfulChange": true
  },
  "contextOptimization": {
    "defaultCharacterBudget": 12000,
    "loadProjectStateFirst": true,
    "selectiveExtraction": true,
    "avoidRepeatedReads": true
  },
  "externalSkills": {
    "impeccable": {
      "mode": "qa-only",
      "installScope": "project",
      "hooks": false,
      "status": "installed"
    },
    "taste": {
      "mode": "adapted-art-direction",
      "status": "enabled"
    },
    "emilMotion": {
      "mode": "adapted-motion-direction",
      "status": "enabled",
      "upstreamCopy": false
    },
    "horizonX": {
      "mode": "isolated-experiment",
      "status": "not-installed"
    }
  },
  "integrations": {
    "chatgpt": "available-manual",
    "codex": "active",
    "githubGit": "active-https-credential-manager",
    "githubCli": "reauth-required-optional",
    "figma": "connected-manual",
    "claudeReview": "deferred-until-needed",
    "tilda": "deferred-until-publishing",
    "remotion": "deferred-until-video-task",
    "threeD": "deferred-until-3d-task",
    "marketingGrowth": "deferred-until-growth-task"
  }
}
