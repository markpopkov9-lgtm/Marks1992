{
  "schemaVersion": 2,
  "name": "JARVIS",
  "mode": "local-first",
  "studioOS": {
    "configFile": "local/config.json",
    "access": "manual"
  },
  "execution": {
    "automaticExternalCalls": false,
    "paidServicesRequired": false
  },
  "projectMemory": {
    "file": "local/project-state.json",
    "template": "templates/project-state.json",
    "updateAfterMeaningfulChange": true
  },
  "contextOptimization": {
    "defaultCharacterBudget": 12000,
    "loadProjectStateFirst": true,
    "selectiveExtraction": true,
    "avoidRepeatedReads": true
  },
  "externalSkills": {
    "impeccable": {
      "mode": "qa-only",
      "installScope": "project",
      "hooks": false,
      "status": "prepared"
    },
    "taste": {
      "mode": "adapted-art-direction",
      "status": "enabled"
    },
    "emilMotion": {
      "mode": "adapted-motion-direction",
      "status": "enabled",
      "upstreamCopy": false
    },
    "horizonX": {
      "mode": "isolated-experiment",
      "status": "not-installed"
    }
  },
  "integrations": {
    "chatgpt": "manual",
    "codex": "manual",
    "github": "not-configured",
    "figma": "manual",
    "claudeReview": "optional-manual",
    "tilda": "optional-manual",
    "remotion": "optional-manual",
    "threeD": "optional-manual",
    "marketingGrowth": "manual"
  }
}
